ENVIRONMENT=production
APP_UID=1000
APP_GID=1000
DATABASE_URL=postgresql+asyncpg://lct:change-me@db:5432/lct2026
MEDIA_DIR=/media
IMPORT_STAGING_DIR=/imports/staging
MAX_IMPORT_ITEMS=100000
DINO_MODEL_PATH=/models/dinov2_label_finetuned
DINO_BASE_MODEL_PATH=/models/dinov2-small
YOLO_MODEL_PATH=/models/yolo_label.pt
EMBEDDING_MODEL_NAME=dinov2-label-v1
# Sites allowed to call the API from a browser, comma separated (the scanner copy on GitHub Pages)
CORS_ORIGINS=https://vadfe.github.io,https://annamistery.github.io
# Public entry for testing by link: docker compose --profile public up -d, links: bash scripts/public_url.sh
PUBLIC_PORT=8031
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_TOP_K=20
CANDIDATE_POOL_SIZE=20
GPU_CONCURRENCY=1
SIFT_CONCURRENCY=2
LOG_LEVEL=INFO
SOMMELIER_MAX_SESSIONS=500
SOMMELIER_SESSION_TTL_SECONDS=3600
POSTGRES_USER=lct
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lct2026
CASCADE_CANDIDATE_POOL=30
CASCADE_V1_WEIGHT=0.3
CASCADE_FOUND_MIN_SIMILARITY=0.83
CASCADE_FOUND_MIN_MARGIN=0.15
CASCADE_REJECT_BELOW_SIMILARITY=0.55
ENABLE_CASCADE_TWIN_RESOLVER=true
CASCADE_TWIN_MAX_GAP=0.15
CASCADE_TWIN_POOL=3
# AI-сомелье: необязательный LLM-слой (Google Gemini). Без ключа ответы строятся по шаблонам движка
GOOGLE_API_KEY=
SOMMELIER_LLM_MODEL=gemini-flash-latest
# Подбор «блюдо → сорт → бутылка» (docs/SOMMELIER_PAIRING.md): рекомендуются только российские вина каталога.
# service — каталог сканера (по умолчанию), demo — вымышленный каталог, retail — выгрузка ритейлера (пока не подключена)
CATALOG_SOURCE=service
SOMMELIER_LLM_PROVIDER=gemini
RETAIL_SOURCE_KIND=csv
RETAIL_SOURCE_URL=
RETAIL_API_KEY=
RETAIL_REFRESH_CRON=0 5 * * *
